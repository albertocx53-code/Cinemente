# =====================================================================
# CineMente — variáveis de ambiente
# Copie para .env.local (o "npm run setup" faz isso e gera os segredos).
# NUNCA envie o .env.local para o GitHub.
# =====================================================================

# Banco de dados -------------------------------------------------------
# Deixe vazio para usar o banco embutido (PGlite) em desenvolvimento.
# Em produção use a connection string do Supabase:
#   Supabase → Project Settings → Database → Connection string → URI
#   (use a do "Session pooler" em hospedagens serverless como a Vercel)
DATABASE_URL=
# true para Supabase / bancos na nuvem
DATABASE_SSL=false

# Segredo usado para guardar os códigos de ativação como hash (HMAC).
# 64 caracteres aleatórios. Se for trocado, os códigos já gerados param de funcionar.
CODE_PEPPER=

# Segredo que protege a cópia criptografada do código mostrada ao comprador.
# 64 caracteres aleatórios. Não troque depois de começar a vender.
SESSION_SECRET=

# Senha do aviso de compra (webhook). Vai no fim da URL cadastrada no checkout:
#   https://SEU-SITE/api/webhooks/compra?token=ESTE_VALOR
WEBHOOK_SECRET=

# Endereço público do site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E-mail de suporte exibido na Central de Ajuda
NEXT_PUBLIC_SUPPORT_EMAIL=

# Link da página de compra (checkout). Se vazio, o botão de compra não aparece.
NEXT_PUBLIC_CHECKOUT_URL=

# E-mail com o código após a compra (Resend: https://resend.com, grátis até 3.000/mês)
# Sem estas duas linhas o código aparece só na tela de compra concluída.
RESEND_API_KEY=
# Remetente. Precisa ser de um domínio verificado no Resend, ex.: CineMente <acesso@cinemente.com.br>
EMAIL_FROM=
